<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MasterClient.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:MasterClient.Views"
        xmlns:connect="using:MasterClient.Connect"
        mc:Ignorable="d"
        d:DesignWidth="1080" d:DesignHeight="680"
        x:Class="MasterClient.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="跑团大师 - TRPG Master"
        Width="1080" Height="680"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Background="#0a0a0f">

    <Grid RowDefinitions="40,*">
        <!-- 自定义标题栏 -->
        <Border Grid.Row="0" Background="#0a0a0f" PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="220,*,Auto">
                <!-- 左侧占位（与导航栏对齐） -->
                <Border Grid.Column="0"/>

                <!-- 中间可拖拽区域 -->
                <Border Grid.Column="1"/>

                <!-- 窗口控制按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" Margin="0,0,8,0">
                    <Button Name="MinimizeButton" Classes="windowButton" Click="MinimizeButton_Click"
                            Width="46" Height="40" Padding="0" CornerRadius="0"
                            Background="Transparent" BorderThickness="0">
                        <TextBlock Text="─" FontSize="12" Foreground="#6b7280"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Name="MaximizeButton" Classes="windowButton" Click="MaximizeButton_Click"
                            Width="46" Height="40" Padding="0" CornerRadius="0"
                            Background="Transparent" BorderThickness="0">
                        <TextBlock Text="□" FontSize="12" Foreground="#6b7280"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Name="CloseButton" Classes="windowButton" Click="CloseButton_Click"
                            Width="46" Height="40" Padding="0" CornerRadius="0"
                            Background="Transparent" BorderThickness="0">
                        <TextBlock Text="✕" FontSize="12" Foreground="#6b7280"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区域 -->
        <Grid Grid.Row="1">
            <!-- 登录视图（居中显示） -->
            <Border IsVisible="{Binding IsLoginView}" Background="#0a0a0f">
                <Border Width="420" Height="500" CornerRadius="16" Background="#1f2937"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <views:LoginView/>
                </Border>
            </Border>

            <!-- 正在连接房间：独立组件 ConnectingView（连接中或错误态都显示，由 IsActive 驱动）-->
            <connect:ConnectingView
                DataContext="{Binding ConnectingVm}"
                IsVisible="{Binding IsActive}"/>

            <!-- 主面板视图 V3 (原神风格大窗口启动器) -->
            <views:MainPanelViewV3 IsVisible="{Binding IsMainPanelView}"/>
        </Grid>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.windowButton:pointerover">
            <Setter Property="Background" Value="#40444B"/>
        </Style>
        <Style Selector="Button.windowButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#DCDDDE"/>
        </Style>
        <Style Selector="Button#CloseButton:pointerover">
            <Setter Property="Background" Value="#ED4245"/>
        </Style>
        <Style Selector="Button#CloseButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>
</Window>
