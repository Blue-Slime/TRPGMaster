<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:panels="using:MasterClient.Chat.Panels"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="280"
        x:Class="MasterClient.Chat.Panels.ChannelDialog"
        x:DataType="panels:ChannelDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#313338">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#1e1f22"/>
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Styles>

    <Border Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Foreground="White"/>

            <StackPanel Spacing="6">
                <TextBlock Text="频道名称" FontSize="13" Foreground="#b5bac1"/>
                <TextBox Text="{Binding ChannelName, Mode=TwoWay}" PlaceholderText="例如 大厅 / 战斗 / 场外"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="分类（留空则归入默认分类）" FontSize="13" Foreground="#b5bac1"/>
                <TextBox Text="{Binding CategoryName, Mode=TwoWay}" PlaceholderText="例如 文字频道 / 语音频道"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#ED4245" FontSize="12"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,0">
                <Button Grid.Column="0" Content="取消"
                        Command="{Binding CancelCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Height="40" Background="#3c3c3c" Foreground="#e0e0e0"/>
                <Button Grid.Column="2" Content="{Binding ConfirmText}"
                        Command="{Binding ConfirmCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Height="40" Background="#5865F2" Foreground="White" FontWeight="SemiBold"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
