<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:search="using:MasterClient.Chat.Search"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="620"
        x:Class="MasterClient.Chat.Search.MessageSearchWindow"
        x:DataType="search:MessageSearchViewModel"
        Title="搜索聊天记录"
        Width="560" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#313338">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#1e1f22"/>
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#1e1f22"/>
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style Selector="DatePicker">
            <Setter Property="Background" Value="#1e1f22"/>
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#b5bac1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <!-- 关键字 + 搜索按钮 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,8,Auto">
            <TextBox Grid.Column="0" Text="{Binding Keyword, Mode=TwoWay}"
                     Watermark="搜索消息内容（可留空，按其它条件筛选）">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="2" Content="搜索" Command="{Binding SearchCommand}"
                    Height="40" Width="72" HorizontalContentAlignment="Center"
                    Background="#5865F2" Foreground="White" FontWeight="SemiBold"/>
        </Grid>

        <!-- 筛选条件 -->
        <Grid Grid.Row="1" Margin="0,14,0,0" ColumnDefinitions="*,10,*" RowDefinitions="Auto,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Classes="label" Text="范围"/>
                <ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding SelectedChannel}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="search:ChannelOption">
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Classes="label" Text="发送人"/>
                <ComboBox ItemsSource="{Binding SenderOptions}" SelectedItem="{Binding SelectedSender}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="search:SenderOption">
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                <TextBlock Classes="label" Text="类型"/>
                <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="search:TypeOption">
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                <TextBlock Classes="label" Text="日期范围（留空=不限）"/>
                <Grid ColumnDefinitions="*,6,*,Auto">
                    <DatePicker Grid.Column="0" SelectedDate="{Binding StartDate, Mode=TwoWay}"/>
                    <DatePicker Grid.Column="2" SelectedDate="{Binding EndDate, Mode=TwoWay}"/>
                    <Button Grid.Column="3" Content="清" Command="{Binding ClearDatesCommand}"
                            Margin="6,0,0,0" Background="#3c3c3c" Foreground="#e0e0e0"
                            ToolTip.Tip="清空日期"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- 结果列表 -->
        <Border Grid.Row="2" Margin="0,14,0,0" Background="#2b2d31" CornerRadius="8">
            <ListBox ItemsSource="{Binding Results}" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="search:SearchResultItem">
                        <Border Padding="12,8" DoubleTapped="OnResultDoubleTapped" Background="Transparent">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding SenderName}" Foreground="#f2f3f5"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <Border Background="#404249" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="{Binding ChannelName}" Foreground="#b5bac1" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                               Foreground="#949ba4" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding Preview}" Foreground="#dbdee1" FontSize="13"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="3" Margin="2,10,0,0" Text="{Binding StatusText}"
                   Foreground="#949ba4" FontSize="12"/>
    </Grid>
</Window>
