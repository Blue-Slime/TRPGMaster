<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MasterServerUI.App"
             xmlns:local="using:MasterServerUI"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />

        <!-- Custom Dark Theme Colors for Server UI -->
        <Style Selector="Window">
            <Setter Property="Background" Value="#1E1E1E"/>
        </Style>

        <!-- Global Text Styles -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        </Style>

        <Style Selector="TextBlock.heading1">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="TextBlock.heading2">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
        </Style>

        <!-- Button Styles -->
        <Style Selector="Button">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#4752C4"/>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#3C45A5"/>
        </Style>
        <Style Selector="Button.success">
            <Setter Property="Background" Value="#3BA55D"/>
        </Style>

        <Style Selector="Button.success:pointerover">
            <Setter Property="Background" Value="#2D7D46"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#ED4245"/>
        </Style>

        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#C03537"/>
        </Style>

        <Style Selector="Button.warning">
            <Setter Property="Background" Value="#FFA500"/>
        </Style>

        <!-- Panel Styles -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- ListBox Styles -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#094771"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#2A2D2E"/>
        </Style>

        <!-- TextBox Styles -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="SelectionBrush" Value="#5865F2"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#5865F2"/>
        </Style>

        <!-- ComboBox Styles -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <!-- ScrollBar Styles -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="#2D2D30"/>
        </Style>

        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#686868"/>
        </Style>

        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#9E9E9E"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SecondaryBackground" Color="#252526"/>
        <SolidColorBrush x:Key="AccentColor" Color="#5865F2"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#3BA55D"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FFA500"/>
        <SolidColorBrush x:Key="DangerColor" Color="#ED4245"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3C3C3C"/>
    </Application.Resources>
</Application>
