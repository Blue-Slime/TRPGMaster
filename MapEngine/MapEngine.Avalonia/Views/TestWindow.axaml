<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:MapEngine.Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MapEngine.Avalonia.Views.TestWindow"
        Title="OpenGL 测试窗口">
    
    <Grid>
        <controls:SilkMapCanvas />
        <TextBlock Text="OpenGL Test Window" Foreground="White" FontSize="24" Margin="20" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
</Window>