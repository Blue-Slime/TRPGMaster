<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="using:MapEngine.Avalonia.ViewModels"
             xmlns:views="using:MapEngine.Avalonia.Views"
             xmlns:controls="using:MapEngine.Avalonia.Controls"
             xmlns:converters="using:MapEngine.Avalonia.Converters"
             xmlns:layout="using:MapEngine.Avalonia.Layout"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1400" d:DesignHeight="860"
             x:Class="MapEngine.Avalonia.Views.MapEditorView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False"
             x:Name="Root"
             Background="{StaticResource AppBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MapEngine.Avalonia/Styles/OwlbearTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
            <converters:BoolToPlayerBadgeBrushConverter x:Key="BoolToPlayerBadgeBrushConverter"/>
            <converters:BoolToPlayerBadgeTextConverter x:Key="BoolToPlayerBadgeTextConverter"/>
            <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- ── DataTemplates ─────────────────────────────────────────── -->
    <UserControl.DataTemplates>
        <TreeDataTemplate DataType="vm:HierarchyItemViewModel" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayName}"
                       DragDrop.AllowDrop="True"
                       DragDrop.DragOver="HierarchyItem_DragOver"
                       DragDrop.Drop="HierarchyItem_Drop">
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="新建空对象"              Click="AddHierarchyChild_Click"       CommandParameter="{Binding .}"/>
                        <MenuItem Header="新建墙壁"             Click="AddWallObject_Click"            CommandParameter="{Binding .}"/>
                        <Separator/>
                        <MenuItem Header="加入先攻表"            Click="AddToInitiativeTracker_Click"   CommandParameter="{Binding .}"/>
                        <MenuItem Header="移出先攻表"            Click="RemoveFromInitiativeTracker_Click" CommandParameter="{Binding .}"/>
                        <Separator/>
                        <MenuItem Header="复制"                    Click="CopyHierarchyItem_Click"        CommandParameter="{Binding .}"/>
                        <MenuItem Header="粘贴为子对象"            Click="PasteHierarchyItem_Click"       CommandParameter="{Binding .}"/>
                        <MenuItem Header="复制副本"                Click="DuplicateHierarchyItem_Click"   CommandParameter="{Binding .}"/>
                        <Separator/>
                        <MenuItem Header="上移"                    Click="MoveHierarchyItemUp_Click"      CommandParameter="{Binding .}"/>
                        <MenuItem Header="下移"                    Click="MoveHierarchyItemDown_Click"    CommandParameter="{Binding .}"/>
                        <MenuItem Header="提升层级（移出父对象）"  Click="PromoteHierarchyItem_Click"     CommandParameter="{Binding .}"/>
                        <MenuItem Header="降低层级（移入上方兄弟）" Click="DemoteHierarchyItem_Click"    CommandParameter="{Binding .}"/>
                        <Separator/>
                        <MenuItem Header="重命名" Click="RenameHierarchyItem_Click" CommandParameter="{Binding .}"/>
                        <Separator/>
                        <MenuItem Header="删除"   Click="DeleteHierarchyItem_Click" CommandParameter="{Binding .}"/>
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="vm:AssetFolderViewModel" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayName}">
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="新增文件夹"    Click="AddAssetFolder_Click"           CommandParameter="{Binding .}"/>
                        <MenuItem Header="新增静态对象类" Click="AddAssetItem_Click"             CommandParameter="{Binding .}"/>
                        <Separator/>
                        <MenuItem Header="复制"          Click="CopyAssetFolder_Click"          CommandParameter="{Binding .}"/>
                        <MenuItem Header="粘贴文件夹"    Click="PasteAssetFolder_Click"         CommandParameter="{Binding .}"/>
                        <MenuItem Header="粘贴对象类"    Click="PasteAssetItemIntoFolder_Click" CommandParameter="{Binding .}"/>
                        <MenuItem Header="复制副本"       Click="DuplicateAssetFolder_Click"    CommandParameter="{Binding .}"/>
                        <Separator/>
                        <MenuItem Header="重命名" Click="RenameAssetFolder_Click" CommandParameter="{Binding .}"/>
                        <MenuItem Header="删除"   Click="DeleteAssetFolder_Click" CommandParameter="{Binding .}"/>
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>
        </TreeDataTemplate>

        <DataTemplate DataType="vm:AssetItemViewModel">
            <Border Width="{Binding #Root.DataContext.AssetTileWidth}"
                    Margin="5" Padding="8"
                    Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                    CornerRadius="6" PointerPressed="AssetCard_PointerPressed">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制"     Click="CopyAssetItem_Click"      CommandParameter="{Binding .}"/>
                        <MenuItem Header="复制副本" Click="DuplicateAssetItem_Click" CommandParameter="{Binding .}"/>
                        <Separator/>
                        <MenuItem Header="重命名" Click="RenameAssetItem_Click" CommandParameter="{Binding .}"/>
                        <MenuItem Header="删除"   Click="DeleteAssetItem_Click" CommandParameter="{Binding .}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Spacing="6">
                    <Border Height="{Binding #Root.DataContext.AssetThumbnailSize}"
                            Background="{StaticResource ThumbnailBackgroundBrush}" CornerRadius="4"
                            ClipToBounds="True">
                        <Panel>
                            <!-- 真实图片缩略图（懒加载，解码完成后自动出现） -->
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                   Margin="4" IsVisible="{Binding HasThumbnail}"/>
                            <!-- 非图片素材 / 解码失败：回退 emoji 图标 -->
                            <TextBlock Text="{Binding Icon}" FontSize="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !HasThumbnail}"/>
                        </Panel>
                    </Border>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Kind}" Foreground="{StaticResource TextTertiaryBrush}"
                               FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 工具按钮：SVG 图标 + 选中态左侧紫色指示条（Owlbear 风格） -->
        <DataTemplate DataType="vm:ToolActionViewModel">
            <Grid Width="40" Height="40" ToolTip.Tip="{Binding ToolTip}">
                <!-- 选中指示条 -->
                <Border Width="3" Height="20" CornerRadius="0,2,2,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{StaticResource AccentBrush}"
                        IsVisible="{Binding IsSelected}"/>
                <!-- SVG 图标 -->
                <Path Data="{Binding IconPath}"
                      Fill="{Binding Foreground}"
                      Width="20" Height="20" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="{Binding HasIconPath}"/>
                <!-- 无 SVG 时回退为文本图标 -->
                <TextBlock Text="{Binding Icon}" Foreground="{Binding Foreground}"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !HasIconPath}"/>
            </Grid>
        </DataTemplate>

        <!-- ── Transform 组件编辑器字段 ─────────────────────────── -->
        <DataTemplate DataType="vm:TransformComponentEditor">
            <StackPanel Spacing="0" Margin="10,4,10,4">
                <!-- X / Y -->
                <Grid ColumnDefinitions="60,*,8,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="位置" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Owner.X, Mode=TwoWay}"
                                   FormatString="F2" Increment="0.5" FontSize="11"
                                   PlaceholderText="X"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                    <NumericUpDown Grid.Column="3" Value="{Binding Owner.Y, Mode=TwoWay}"
                                   FormatString="F2" Increment="0.5" FontSize="11"
                                   PlaceholderText="Y"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>
                <!-- 旋转 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="旋转" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Owner.Rotation, Mode=TwoWay}"
                                   FormatString="F1" Increment="5" Minimum="-360" Maximum="360" FontSize="11"
                                   PlaceholderText="°"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>
                <!-- 缩放 -->
                <Grid ColumnDefinitions="60,*,8,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="缩放" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Owner.ScaleX, Mode=TwoWay}"
                                   FormatString="F2" Increment="0.1" Minimum="0.01" FontSize="11"
                                   PlaceholderText="X"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                    <NumericUpDown Grid.Column="3" Value="{Binding Owner.ScaleY, Mode=TwoWay}"
                                   FormatString="F2" Increment="0.1" Minimum="0.01" FontSize="11"
                                   PlaceholderText="Y"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>
                <!-- Z 层 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="层级 Z" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Owner.Z, Mode=TwoWay}"
                                   FormatString="F0" Increment="1" FontSize="11"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- ── SpriteRenderer 组件编辑器字段 ─────────────────────── -->
        <DataTemplate DataType="vm:SpriteRendererComponentEditor">
            <StackPanel Spacing="0" Margin="10,4,10,4">
                <!-- 素材路径（只读展示） -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="素材" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Owner.SourceAssetName}" FontSize="11"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Owner.SourceAssetPath}"/>
                </Grid>
                <!-- 切换图片按钮 -->
                <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
                    <Button Grid.Column="0" Content="选择图片..." FontSize="11"
                            Click="SelectSpriteImage_Click"
                            Background="{StaticResource ToolbarBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                            Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="8,4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="从素材库" FontSize="11"
                            Click="PickSpriteFromAsset_Click"
                            Background="{StaticResource ToolbarBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                            Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="8,4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </Grid>
                <!-- 颜色 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="颜色" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Owner.SpriteColor, Mode=TwoWay}"
                             FontSize="11" PlaceholderText="#FFFFFFFF"
                             Background="{StaticResource ToolbarBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                             Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>
                <!-- 透明度 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="透明度" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Value="{Binding Owner.Opacity, Mode=TwoWay}"
                            Minimum="0" Maximum="1" TickFrequency="0.05"
                            VerticalAlignment="Center"/>
                </Grid>
                <!-- 对齐偏移 -->
                <Grid ColumnDefinitions="60,*,8,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="对齐" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Owner.SpriteAlignX, Mode=TwoWay}"
                                   FormatString="F0" Increment="1" FontSize="11" PlaceholderText="X"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                    <NumericUpDown Grid.Column="3" Value="{Binding Owner.SpriteAlignY, Mode=TwoWay}"
                                   FormatString="F0" Increment="1" FontSize="11" PlaceholderText="Y"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>
                <!-- 可点击 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="可点击" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Owner.SpriteHitTestEnabled, Mode=TwoWay}"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- ── Vision 组件编辑器字段（多视野锥，不限数量）──────────── -->
        <DataTemplate DataType="vm:VisionComponentEditor">
            <StackPanel Spacing="0" Margin="10,4,10,6">

                <!-- 全局开关 + 默认半径 + 朝向 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="启用" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Owner.VisionEnabled, Mode=TwoWay}"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </Grid>
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="默认半径" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Owner.VisionRadius, Mode=TwoWay}"
                                   FormatString="F0" Increment="5" Minimum="0" FontSize="11"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="朝向" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Owner.Orientation, Mode=TwoWay}"
                                   FormatString="F1" Increment="5" Minimum="-360" Maximum="360" FontSize="11"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 视野锥列表标题 + 添加按钮 -->
                <Border Margin="0,6,0,2" BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,2">
                        <TextBlock Grid.Column="0" Text="视野锥" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Background="Transparent" BorderThickness="0"
                                Padding="4,2" CornerRadius="4"
                                ToolTip.Tip="添加视野锥"
                                Command="{Binding #Root.DataContext.AddVisionConeCommand}"
                                CommandParameter="{Binding Owner}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Stretch="Uniform"
                                      Fill="{StaticResource CapsulePurpleBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="添加" FontSize="10"
                                           Foreground="{StaticResource CapsulePurpleBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 每个视野锥的展开行 -->
                <ItemsControl ItemsSource="{Binding Owner.VisionCones}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:VisionConeViewModel">
                            <Border Margin="0,1" Padding="6,4"
                                    Background="{StaticResource ToolbarBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel Spacing="3">
                                    <!-- 标题行：名称 + 启用开关 + 删除 -->
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}"
                                                 FontSize="11" FontWeight="SemiBold"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 Padding="0"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  ToolTip.Tip="启用此锥" Margin="4,0"/>
                                        <Button Grid.Column="2"
                                                Background="Transparent" BorderThickness="0"
                                                Width="18" Height="18" Padding="0" CornerRadius="4"
                                                ToolTip.Tip="删除"
                                                Command="{Binding #Root.DataContext.RemoveVisionConeCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stretch="Uniform"
                                                  Fill="{StaticResource TextTertiaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                    <!-- 原点偏移 / 视距 / FOV -->
                                    <Grid ColumnDefinitions="Auto,*,8,Auto,*,8,Auto,*">
                                        <TextBlock Grid.Column="0" Text="偏移" FontSize="10"
                                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <NumericUpDown Grid.Column="1" Value="{Binding CenterOffset, Mode=TwoWay}"
                                                       FormatString="F0" Increment="5" Minimum="-360" Maximum="360"
                                                       FontSize="10" Height="24"
                                                       Background="{StaticResource AppBackgroundBrush}"
                                                       BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                                       Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="3" Padding="2,1"/>
                                        <TextBlock Grid.Column="3" Text="距离" FontSize="10"
                                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <NumericUpDown Grid.Column="4" Value="{Binding Range, Mode=TwoWay}"
                                                       FormatString="F1" Increment="1" Minimum="0.5"
                                                       FontSize="10" Height="24"
                                                       Background="{StaticResource AppBackgroundBrush}"
                                                       BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                                       Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="3" Padding="2,1"/>
                                        <TextBlock Grid.Column="6" Text="FOV" FontSize="10"
                                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <NumericUpDown Grid.Column="7" Value="{Binding FieldOfView, Mode=TwoWay}"
                                                       FormatString="F0" Increment="10" Minimum="10" Maximum="360"
                                                       FontSize="10" Height="24"
                                                       Background="{StaticResource AppBackgroundBrush}"
                                                       BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                                       Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="3" Padding="2,1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空态提示 -->
                <TextBlock IsVisible="{Binding Owner.VisionCones.Count, Converter={x:Static ObjectConverters.IsNull}}"
                           Text="无视野锥（使用默认全向视野）" FontSize="10" FontStyle="Italic"
                           Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2"/>

            </StackPanel>
        </DataTemplate>

        <!-- ── Wall 组件编辑器字段 ────────────────────────────────── -->
        <DataTemplate DataType="vm:WallComponentEditor">
            <StackPanel Spacing="0" Margin="10,4,10,4">
                <!-- 墙壁类型 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="类型" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Owner.WallType, Mode=TwoWay}"
                              FontSize="11" Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2">
                        <ComboBoxItem Content="实心墙"/>
                        <ComboBoxItem Content="门"/>
                        <ComboBoxItem Content="窗户"/>
                        <ComboBoxItem Content="隐形墙"/>
                        <ComboBoxItem Content="地形"/>
                    </ComboBox>
                </Grid>
                <!-- 阻挡视线 / 移动 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="阻视线" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Owner.WallBlocksVision, Mode=TwoWay}"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </Grid>
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="阻移动" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Owner.WallBlocksMovement, Mode=TwoWay}"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </Grid>
                <!-- 门特有 -->
                <StackPanel IsVisible="{Binding Owner.IsDoor}" Spacing="0">
                    <Grid ColumnDefinitions="60,*" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="门已开" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding Owner.IsDoorOpen, Mode=TwoWay}"
                                  Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </Grid>
                </StackPanel>
                <!-- 厚度 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="厚度" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Owner.WallThickness, Mode=TwoWay}"
                                   FormatString="F0" Increment="1" Minimum="1" Maximum="50" FontSize="11"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- ── WallPath 组件编辑器字段（墙体路径+门窗系统）─────────── -->
        <DataTemplate DataType="vm:WallPathComponentEditor">
            <StackPanel Spacing="0" Margin="10,4,10,6">

                <!-- 路径几何 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="闭合路径" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsClosed, Mode=TwoWay}"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </Grid>

                <!-- 感知通道分组 -->
                <Border Margin="0,6,0,2" BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="感知通道" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,6,0,2"/>
                </Border>

                <!-- 视觉 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="视觉" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SenseLevelOptions}"
                              SelectedIndex="{Binding SightIndex, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                </Grid>

                <!-- 移动 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="移动" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SenseLevelOptions}"
                              SelectedIndex="{Binding MoveIndex, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                </Grid>

                <!-- 声音 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="声音" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SenseLevelOptions}"
                              SelectedIndex="{Binding SoundIndex, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                </Grid>

                <!-- 光线 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="光线" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SenseLevelOptions}"
                              SelectedIndex="{Binding LightIndex, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                </Grid>

                <!-- 渲染参数 -->
                <Border Margin="0,6,0,2" BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="渲染" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,6,0,2"/>
                </Border>

                <!-- 线宽 -->
                <Grid ColumnDefinitions="60,*,32" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="线宽" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Value="{Binding Thickness, Mode=TwoWay}"
                            Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Thickness, StringFormat={}{0:F0}px}"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <!-- 颜色：色块 + hex -->
                <Grid ColumnDefinitions="60,20,4,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="颜色" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="18" Height="18" CornerRadius="4"
                            BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                            Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}"/>
                    <TextBox Grid.Column="3" Text="{Binding Color, Mode=TwoWay}"
                             FontSize="11" PlaceholderText="#D32F2F"
                             Background="{StaticResource ToolbarBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                             Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 调色板 -->
                <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="60,2,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="20" Height="20" Padding="0" Margin="0,0,4,0"
                                    CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrushToken}"
                                    Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                    ToolTip.Tip="{Binding}"
                                    Command="{Binding $parent[ItemsControl].DataContext.PickColorCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 门窗列表 -->
                <Border Margin="0,8,0,2" BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,2">
                        <TextBlock Grid.Column="0" Text="门窗" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Background="Transparent" BorderThickness="0"
                                Padding="4,2" CornerRadius="4"
                                ToolTip.Tip="添加门窗"
                                Command="{Binding AddDoorCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Stretch="Uniform"
                                      Fill="{StaticResource CapsulePurpleBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="添加" FontSize="10"
                                           Foreground="{StaticResource CapsulePurpleBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 门窗条目列表 -->
                <ItemsControl ItemsSource="{Binding Doors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:DoorItemViewModel">
                            <Border Margin="0,2" Padding="8,6"
                                    Background="{StaticResource ToolbarBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                    CornerRadius="6">
                                <StackPanel Spacing="4">
                                    <!-- 标题行：图标+标签 + 删除 -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding DoorLabel}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Background="Transparent" BorderThickness="0"
                                                Width="18" Height="18" Padding="0" CornerRadius="4"
                                                ToolTip.Tip="删除门窗"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveDoorCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stretch="Uniform"
                                                  Fill="{StaticResource TextTertiaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>

                                    <!-- 类型 / 状态 -->
                                    <Grid ColumnDefinitions="*,8,*">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="类型" FontSize="9"
                                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding KindOptions}"
                                                      SelectedIndex="{Binding KindIndex, Mode=TwoWay}"
                                                      FontSize="10" Height="24" Padding="4,0"
                                                      Background="{StaticResource AppBackgroundBrush}"
                                                      BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                                      Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="状态" FontSize="9"
                                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding StateOptions}"
                                                      SelectedIndex="{Binding StateIndex, Mode=TwoWay}"
                                                      FontSize="10" Height="24" Padding="4,0"
                                                      Background="{StaticResource AppBackgroundBrush}"
                                                      BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                                      Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="3"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 开门方向 -->
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="开门方向" FontSize="9"
                                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <ComboBox ItemsSource="{Binding SwingOptions}"
                                                  SelectedIndex="{Binding SwingIndex, Mode=TwoWay}"
                                                  FontSize="10" Height="24" Padding="4,0"
                                                  Background="{StaticResource AppBackgroundBrush}"
                                                  BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                                  Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="3"/>
                                    </StackPanel>

                                    <!-- 感知覆盖（可折叠） -->
                                    <Expander Header="感知覆盖（可选）" FontSize="9" Padding="0,2">
                                        <StackPanel Spacing="3" Margin="0,4,0,0">
                                            <Grid ColumnDefinitions="40,*">
                                                <TextBlock Grid.Column="0" Text="视觉" FontSize="9"
                                                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding SenseOverrideOptions}"
                                                          SelectedIndex="{Binding SightOverrideIndex, Mode=TwoWay}"
                                                          FontSize="10" Height="22" Padding="4,0"
                                                          Background="{StaticResource AppBackgroundBrush}"
                                                          BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                                          Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="3"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="40,*">
                                                <TextBlock Grid.Column="0" Text="移动" FontSize="9"
                                                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding SenseOverrideOptions}"
                                                          SelectedIndex="{Binding MoveOverrideIndex, Mode=TwoWay}"
                                                          FontSize="10" Height="22" Padding="4,0"
                                                          Background="{StaticResource AppBackgroundBrush}"
                                                          BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                                          Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="3"/>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空态提示 + 操作提示 -->
                <StackPanel IsVisible="{Binding Doors.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                            Spacing="3" Margin="0,2,0,4">
                    <TextBlock Text="无门窗" FontSize="10" FontStyle="Italic"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                    <Border Background="{StaticResource AppBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                            CornerRadius="4" Padding="6,4">
                        <TextBlock Text="💡 右键墙体线段可添加门窗" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

            </StackPanel>
        </DataTemplate>

        <!-- ── Token 组件编辑器字段（现代卡片式）───────────────────── -->
        <DataTemplate DataType="vm:TokenComponentEditor">
            <StackPanel Spacing="0" Margin="10,4,10,6">

                <!-- ─ 卡片：肖像 + 名称 + PJ/PNJ 徽章 ─ -->
                <Border Padding="8,6"
                        Background="{StaticResource ToolbarBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                        CornerRadius="6" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="52,*">
                        <!-- 肖像区域 -->
                        <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,8,0">
                            <!-- 占位底色 -->
                            <Border CornerRadius="6"
                                    Background="{StaticResource AppBackgroundBrush}"
                                    BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="1"/>
                            <!-- 肖像图（暂用 TextBlock 图标代替，等 crop 工具接入后换 Image） -->
                            <TextBlock Text="?" FontSize="20" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                            <!-- 切框按钮 -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,-2,-2"
                                    Background="{StaticResource CapsuleActionBrush}"
                                    BorderThickness="0" CornerRadius="4"
                                    Width="18" Height="18" Padding="0"
                                    ToolTip.Tip="设置肖像（裁剪）"
                                    Click="PickTokenPortrait_Click">
                                <TextBlock Text="✂" FontSize="9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- 右侧：名称 + 徽章 + HP bar -->
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <!-- 名称 + PJ/PNJ 徽章 -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding Owner.TokenName, Mode=TwoWay}"
                                         FontSize="12" FontWeight="SemiBold"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         PlaceholderText="Token 名称" Padding="0"/>
                                <Border Grid.Column="1" CornerRadius="4" Padding="4,1"
                                        Background="{Binding Owner.IsPlayerControlled,
                                            Converter={StaticResource BoolToPlayerBadgeBrushConverter}}"
                                        VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock FontSize="9" FontWeight="Bold"
                                               Text="{Binding Owner.IsPlayerControlled,
                                                   Converter={StaticResource BoolToPlayerBadgeTextConverter}}"
                                               Foreground="White"/>
                                </Border>
                            </Grid>

                            <!-- HP 条（固定 100px 满格，PercentToWidthConverter 把 0-100 → 0-100px） -->
                            <Border CornerRadius="3" Height="6" MaxWidth="200"
                                    Background="{Binding Owner.HPBarBackground}"
                                    ClipToBounds="True" HorizontalAlignment="Stretch">
                                <Border HorizontalAlignment="Left" CornerRadius="3"
                                        Background="{Binding Owner.HPBarColor}"
                                        Width="{Binding Owner.HPPercent,
                                            Converter={StaticResource PercentToWidthConverter}}"/>
                            </Border>

                            <!-- HP 数值：当前 / 最大 -->
                            <Grid ColumnDefinitions="Auto,*,Auto,*" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="HP" FontSize="10"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding Owner.CurrentHP, Mode=TwoWay}"
                                               FormatString="F0" Increment="1" Minimum="0"
                                               FontSize="10" Height="22"
                                               Background="{StaticResource AppBackgroundBrush}"
                                               BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                               Foreground="{Binding Owner.HPBarColor}"
                                               CornerRadius="3" Padding="2,0"/>
                                <TextBlock Grid.Column="2" Text="/" FontSize="10"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="3,0"/>
                                <NumericUpDown Grid.Column="3"
                                               Value="{Binding Owner.MaxHP, Mode=TwoWay}"
                                               FormatString="F0" Increment="1" Minimum="1"
                                               FontSize="10" Height="22"
                                               Background="{StaticResource AppBackgroundBrush}"
                                               BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               CornerRadius="3" Padding="2,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─ 附加属性 ─ -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="先攻" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Owner.InitiativeOrder, Mode=TwoWay}"
                                   FormatString="F0" Increment="1" FontSize="11"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="玩家控制" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Owner.IsPlayerControlled, Mode=TwoWay}"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </Grid>
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="移速" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Owner.MovementSpeed, Mode=TwoWay}"
                                   FormatString="F0" Increment="5" Minimum="0" FontSize="11"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="先攻表显示" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsInInitiativeTracker, Mode=TwoWay}"
                              Content="显示在先攻追踪器中"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </Grid>
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="Token 形状" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ShapeOptions}"
                              SelectedIndex="{Binding ShapeIndex, Mode=TwoWay}"
                              FontSize="11"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- ─ 状态管理 ─ -->
                <Border Margin="0,8,0,4" Padding="8,6"
                        Background="{StaticResource ToolbarBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="6">
                        <TextBlock Text="状态效果" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                        <!-- 当前状态列表 -->
                        <ItemsControl ItemsSource="{Binding Conditions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2" Padding="6,4"
                                            Background="{StaticResource AppBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                            CornerRadius="4">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding RemainingRoundsText}" FontSize="10"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" Margin="6,0"/>
                                            <Button Grid.Column="3" Content="×" FontSize="12" FontWeight="Bold"
                                                    Width="20" Height="20" Padding="0" CornerRadius="10"
                                                    Background="{StaticResource CapsuleActionBrush}"
                                                    BorderThickness="0"
                                                    Foreground="{StaticResource TextTertiaryBrush}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveConditionCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 添加状态按钮（预设列表） -->
                        <Button Content="+ 添加状态" FontSize="11"
                                Background="{StaticResource CapsuleActionBrush}"
                                BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                CornerRadius="4" Padding="6,3" HorizontalAlignment="Stretch"
                                Click="AddCondition_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </DataTemplate>

        <!-- ── Shape 组件编辑器字段（矢量图形样式）──────────────────── -->
        <DataTemplate DataType="vm:ShapeComponentEditor">
            <StackPanel Spacing="0" Margin="10,4,10,6">

                <!-- 形状类型（只读） -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="类型" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Owner.ShapeTypeLabel}" FontSize="11"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- 描边颜色：色块 + hex 输入 -->
                <Grid ColumnDefinitions="60,20,4,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="描边色" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="18" Height="18" CornerRadius="4"
                            BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                            Background="{Binding Owner.ShapeStrokeColor,
                                Converter={StaticResource HexToBrushConverter}}"/>
                    <TextBox Grid.Column="3" Text="{Binding Owner.ShapeStrokeColor, Mode=TwoWay}"
                             FontSize="11" PlaceholderText="#845EF7"
                             Background="{StaticResource ToolbarBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                             Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 描边调色板 -->
                <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="60,2,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="20" Height="20" Padding="0" Margin="0,0,4,0"
                                    CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrushToken}"
                                    Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                    ToolTip.Tip="{Binding}"
                                    Command="{Binding $parent[ItemsControl].DataContext.ApplyStrokeColorCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 填充开关 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="填充" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Owner.ShapeIsFilled, Mode=TwoWay}"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </Grid>

                <!-- 填充颜色：色块 + hex 输入（仅填充开启时可用） -->
                <Grid ColumnDefinitions="60,20,4,*" Margin="0,2"
                      IsEnabled="{Binding Owner.ShapeIsFilled}">
                    <TextBlock Grid.Column="0" Text="填充色" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="18" Height="18" CornerRadius="4"
                            BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                            Background="{Binding Owner.ShapeFillColor,
                                Converter={StaticResource HexToBrushConverter}}"/>
                    <TextBox Grid.Column="3" Text="{Binding Owner.ShapeFillColor, Mode=TwoWay}"
                             FontSize="11" PlaceholderText="#40845EF7"
                             Background="{StaticResource ToolbarBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                             Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 填充调色板（自动套 0x40 alpha） -->
                <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="60,2,0,4"
                              IsEnabled="{Binding Owner.ShapeIsFilled}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="20" Height="20" Padding="0" Margin="0,0,4,0"
                                    CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrushToken}"
                                    Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                    ToolTip.Tip="{Binding}"
                                    Command="{Binding $parent[ItemsControl].DataContext.ApplyFillColorCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 描边宽度 -->
                <Grid ColumnDefinitions="60,*,32" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="描边宽" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Value="{Binding Owner.ShapeStrokeWidth, Mode=TwoWay}"
                            Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Owner.ShapeStrokeWidth, StringFormat={}{0:F0}px}"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <!-- 描边样式 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="线型" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding StrokeStyleOptions}"
                              SelectedIndex="{Binding Owner.ShapeStrokeStyleIndex, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                </Grid>

                <!-- 尺寸（rect / ellipse / circle） -->
                <Grid ColumnDefinitions="60,*,8,*" Margin="0,2" IsVisible="{Binding Owner.ShapeHasSize}">
                    <TextBlock Grid.Column="0" Text="尺寸" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Owner.ShapeWidth, Mode=TwoWay}"
                                   FormatString="F0" Increment="5" Minimum="1" FontSize="11" PlaceholderText="宽"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                    <NumericUpDown Grid.Column="3" Value="{Binding Owner.ShapeHeight, Mode=TwoWay}"
                                   FormatString="F0" Increment="5" Minimum="1" FontSize="11" PlaceholderText="高"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>
                <!-- 锥形参数（cone / wedge） -->
                <StackPanel Spacing="0" IsVisible="{Binding Owner.ShapeHasCone}">
                    <Grid ColumnDefinitions="60,*" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="半径" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding Owner.ShapeConeRadius, Mode=TwoWay}"
                                       FormatString="F0" Increment="10" Minimum="1" FontSize="11"
                                       Background="{StaticResource ToolbarBackgroundBrush}"
                                       BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                       Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                    </Grid>
                    <Grid ColumnDefinitions="60,*" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="半张角" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding Owner.ShapeConeAngle, Mode=TwoWay}"
                                       FormatString="F0" Increment="5" Minimum="1" Maximum="180" FontSize="11"
                                       Background="{StaticResource ToolbarBackgroundBrush}"
                                       BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                       Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                    </Grid>
                    <Grid ColumnDefinitions="60,*" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="朝向" FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding Owner.ShapeRotation, Mode=TwoWay}"
                                       FormatString="F1" Increment="5" Minimum="-360" Maximum="360" FontSize="11"
                                       Background="{StaticResource ToolbarBackgroundBrush}"
                                       BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                       Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
        </DataTemplate>

        <!-- ── Text 组件编辑器字段（地图文本标注）───────────────────── -->
        <DataTemplate DataType="vm:TextComponentEditor">
            <StackPanel Spacing="0" Margin="10,4,10,6">

                <!-- 内容（多行） -->
                <TextBox Text="{Binding Owner.TextContent, Mode=TwoWay}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="52" MaxHeight="120" FontSize="11" Margin="0,2"
                         PlaceholderText="文本内容"
                         Background="{StaticResource ToolbarBackgroundBrush}"
                         BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                         Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>

                <!-- 字号 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="字号" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Owner.TextFontSize, Mode=TwoWay}"
                                   FormatString="F0" Increment="2" Minimum="4" Maximum="400" FontSize="11"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 文字颜色：色块 + hex -->
                <Grid ColumnDefinitions="60,20,4,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="文字色" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="18" Height="18" CornerRadius="4"
                            BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                            Background="{Binding Owner.TextColor,
                                Converter={StaticResource HexToBrushConverter}}"/>
                    <TextBox Grid.Column="3" Text="{Binding Owner.TextColor, Mode=TwoWay}"
                             FontSize="11" PlaceholderText="#F8F9FA"
                             Background="{StaticResource ToolbarBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                             Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 文字调色板 -->
                <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="60,2,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="20" Height="20" Padding="0" Margin="0,0,4,0"
                                    CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrushToken}"
                                    Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                    ToolTip.Tip="{Binding}"
                                    Command="{Binding $parent[ItemsControl].DataContext.ApplyTextColorCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 底板颜色 -->
                <Grid ColumnDefinitions="60,20,4,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="底板色" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="18" Height="18" CornerRadius="4"
                            BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                            Background="{Binding Owner.TextBackgroundColor,
                                Converter={StaticResource HexToBrushConverter}}"/>
                    <TextBox Grid.Column="3" Text="{Binding Owner.TextBackgroundColor, Mode=TwoWay}"
                             FontSize="11" PlaceholderText="#A0000000（透明填 #00000000）"
                             Background="{StaticResource ToolbarBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                             Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 粗体 / 斜体 -->
                <Grid ColumnDefinitions="60,Auto,12,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="样式" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Owner.TextIsBold, Mode=TwoWay}"
                              Content="粗体" FontSize="11"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                    <CheckBox Grid.Column="3" IsChecked="{Binding Owner.TextIsItalic, Mode=TwoWay}"
                              Content="斜体" FontSize="11"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>

                <!-- 对齐 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="对齐" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AlignOptions}"
                              SelectedIndex="{Binding Owner.TextAlignIndex, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                </Grid>

            </StackPanel>
        </DataTemplate>

        <!-- ── Graph Node 组件编辑器字段（拓扑节点）───────────────────── -->
        <DataTemplate DataType="vm:GraphNodeComponentEditor">
            <StackPanel Spacing="0" Margin="10,4,10,6">

                <!-- 显示名（留空则用对象名） -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="显示名" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Owner.GraphNodeDisplayName, Mode=TwoWay}"
                             FontSize="11" PlaceholderText="留空则用对象名"
                             Background="{StaticResource ToolbarBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                             Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 节点类型 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="类型" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding KindOptions}"
                              SelectedIndex="{Binding Owner.GraphNodeKindIndex, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                </Grid>

                <!-- 揭示状态 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="可见性" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding VisibilityOptions}"
                              SelectedIndex="{Binding Owner.GraphNodeVisibilityIndex, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                </Grid>

                <!-- 渲染方式 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="渲染" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding RenderModeOptions}"
                              SelectedIndex="{Binding Owner.GraphNodeRenderModeIndex, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                </Grid>

                <!-- 形状 + 尺寸 -->
                <Grid ColumnDefinitions="60,*,8,60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="形状" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ShapeOptions}"
                              SelectedItem="{Binding Owner.GraphNodeShape, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                    <TextBlock Grid.Column="3" Text="尺寸" FontSize="11" Margin="4,0,0,0"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="4" Value="{Binding Owner.GraphNodeSize, Mode=TwoWay}"
                                   FormatString="F0" Increment="8" Minimum="8" Maximum="512" FontSize="11"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 节点颜色 -->
                <Grid ColumnDefinitions="60,20,4,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="颜色" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="18" Height="18" CornerRadius="4"
                            BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                            Background="{Binding Owner.GraphNodeColor,
                                Converter={StaticResource HexToBrushConverter}}"/>
                    <TextBox Grid.Column="3" Text="{Binding Owner.GraphNodeColor, Mode=TwoWay}"
                             FontSize="11" PlaceholderText="#4A90E2"
                             Background="{StaticResource ToolbarBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                             Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 节点调色板 -->
                <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="60,2,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="20" Height="20" Padding="0" Margin="0,0,4,0"
                                    CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrushToken}"
                                    Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                    ToolTip.Tip="{Binding}"
                                    Command="{Binding $parent[ItemsControl].DataContext.ApplyNodeColorCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 描述 -->
                <TextBox Text="{Binding Owner.GraphNodeDescription, Mode=TwoWay}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="44" MaxHeight="110" FontSize="11" Margin="0,2"
                         PlaceholderText="节点描述"
                         Background="{StaticResource ToolbarBackgroundBrush}"
                         BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                         Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>

            </StackPanel>
        </DataTemplate>

        <!-- ── Graph Link 组件编辑器字段（拓扑通道，可多条）───────────── -->
        <DataTemplate DataType="vm:GraphLinkComponentEditor">
            <StackPanel Spacing="0" Margin="10,4,10,6">

                <!-- 目标节点（只读展示，改目标靠画布拖拽重连） -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="目标" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding TargetNodeDisplay}"
                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>

                <!-- 标签 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="标签" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Label, Mode=TwoWay}"
                             FontSize="11" PlaceholderText="如：需要钥匙"
                             Background="{StaticResource ToolbarBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                             Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 通道类型 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="类型" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding KindOptions}"
                              SelectedIndex="{Binding KindIndex, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                </Grid>

                <!-- 可见性 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="可见性" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding VisibilityOptions}"
                              SelectedIndex="{Binding VisibilityIndex, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                </Grid>

                <!-- 双向 / 可通行 -->
                <Grid ColumnDefinitions="60,Auto,12,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="通行" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsBidirectional, Mode=TwoWay}"
                              Content="双向" FontSize="11"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                    <CheckBox Grid.Column="3" IsChecked="{Binding IsPassable, Mode=TwoWay}"
                              Content="可通行" FontSize="11"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>

                <!-- 代价 + 线宽 -->
                <Grid ColumnDefinitions="60,*,8,60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="代价" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Cost, Mode=TwoWay}"
                                   FormatString="F2" Increment="0.5" Minimum="0.01" Maximum="9999" FontSize="11"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                    <TextBlock Grid.Column="3" Text="线宽" FontSize="11" Margin="4,0,0,0"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="4" Value="{Binding LinkWidth, Mode=TwoWay}"
                                   FormatString="F0" Increment="1" Minimum="1" Maximum="32" FontSize="11"
                                   Background="{StaticResource ToolbarBackgroundBrush}"
                                   BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                   Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 线型 -->
                <Grid ColumnDefinitions="60,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="线型" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding StrokeStyleOptions}"
                              SelectedIndex="{Binding StrokeStyleIndex, Mode=TwoWay}"
                              FontSize="11" Height="26" Padding="6,0"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                              Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4"/>
                </Grid>

                <!-- 连线颜色 -->
                <Grid ColumnDefinitions="60,20,4,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="颜色" FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="18" Height="18" CornerRadius="4"
                            BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                            Background="{Binding LinkColor,
                                Converter={StaticResource HexToBrushConverter}}"/>
                    <TextBox Grid.Column="3" Text="{Binding LinkColor, Mode=TwoWay}"
                             FontSize="11" PlaceholderText="#8A8F98"
                             Background="{StaticResource ToolbarBackgroundBrush}"
                             BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                             Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="4,2"/>
                </Grid>

                <!-- 连线调色板 -->
                <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="60,2,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="20" Height="20" Padding="0" Margin="0,0,4,0"
                                    CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrushToken}"
                                    Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                    ToolTip.Tip="{Binding}"
                                    Command="{Binding $parent[ItemsControl].DataContext.ApplyLinkColorCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </DataTemplate>

        <!-- ── 兜底编辑器（只读显示类型名）─────────────────────────── -->
        <DataTemplate DataType="vm:GenericComponentEditor">
            <TextBlock Margin="10,4" FontSize="11" FontStyle="Italic"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       Text="{Binding Owner.ObjectType}"/>
        </DataTemplate>
    </UserControl.DataTemplates>

    <!-- ════════════════════════════════════════════════════════════════
         根 Grid：地图全屏，所有面板叠加（Owlbear 2 风格）
         ════════════════════════════════════════════════════════════════ -->
    <Grid x:Name="RootGrid">

        <!-- ── 地图视口（底层全铺）──────────────────────────────────── -->
        <Border x:Name="MapViewportSurface"
                Background="Transparent" ClipToBounds="True"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="MapDropTarget_DragOver"
                DragDrop.DragLeave="MapDropTarget_DragLeave"
                DragDrop.Drop="MapDropTarget_Drop">
            <Grid x:Name="MapViewportHost"
                  Background="Transparent"
                  SizeChanged="MapViewportHost_SizeChanged">
                <controls:SilkMapCanvas x:Name="MapSilkCanvas"
                                        IsHitTestVisible="False"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                <!-- 地图文本标注覆盖层（GL 层无字体栈，文本走 Avalonia） -->
                <Canvas x:Name="MapTextOverlay"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"/>
                <!-- 工具临时 overlay：Measure/Laser/Shape preview，不走 GL 管线 -->
                <Canvas x:Name="ToolOverlayCanvas"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"/>
            </Grid>
        </Border>

        <!-- ══ 顶部先攻抽屉（横向滑动卡片 + 中央指示器）══════════════════ -->
        <views:InitiativeTopDrawer DataContext="{Binding InitiativeTracker}"
                                    ZIndex="50"
                                    IsVisible="{Binding $parent[UserControl].DataContext.IsTopDrawerOpen}">
            <views:InitiativeTopDrawer.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </views:InitiativeTopDrawer.Transitions>
            <views:InitiativeTopDrawer.Styles>
                <!-- 默认：隐藏在上方 -->
                <Style Selector="views|InitiativeTopDrawer">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="RenderTransform" Value="translateY(-160px)"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </Style>
                <!-- 打开状态：滑入显示 -->
                <Style Selector="views|InitiativeTopDrawer[IsVisible=True]">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="RenderTransform" Value="translateY(0px)"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </Style>
            </views:InitiativeTopDrawer.Styles>
        </views:InitiativeTopDrawer>

        <!-- ══ 骰子面板（右侧弹出浮层）══════════════════════════════════ -->
        <views:DicePanel x:Name="DicePanel"
                         DataContext="{Binding Dice}"
                         ZIndex="50"
                         Margin="0,14,14,0"
                         IsVisible="{Binding $parent[UserControl].DataContext.IsDicePanelOpen}"
                         HorizontalAlignment="Right" VerticalAlignment="Top">
            <views:DicePanel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </views:DicePanel.Transitions>
            <views:DicePanel.Styles>
                <Style Selector="views|DicePanel">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="RenderTransform" Value="translateX(40px)"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </Style>
                <Style Selector="views|DicePanel[IsVisible=True]">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="RenderTransform" Value="translateX(0px)"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </Style>
            </views:DicePanel.Styles>
        </views:DicePanel>

        <!-- ════════════════════════════════════════════════════════════
             左上工具胶囊：模式切换 + 主工具
             竖列排列，满列换列继续排；随 LeftDrawer 右移，随 BottomDrawer 底部压缩
             ════════════════════════════════════════════════════════════ -->
        <Border x:Name="ToolbarCapsule"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="14,14,0,62" ZIndex="30"
                CornerRadius="24"
                Background="{StaticResource CapsuleToolbarBrush}"
                BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="1"
                BoxShadow="{StaticResource ShadowCapsule}"
                Padding="5,10">
            <Border.Transitions>
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <Border.Styles>
                <Style Selector="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="CornerRadius" Value="12"/>
                </Style>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{StaticResource CapsuleHoverBrush}"/>
                </Style>
                <Style Selector="Button:pressed /template/ ContentPresenter">
                    <Setter Property="Background" Value="{StaticResource CapsuleSelectedBrush}"/>
                </Style>
                <Style Selector="Button:disabled /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </Border.Styles>

            <StackPanel Orientation="Vertical" Spacing="0">
                <!-- 模式切换 -->
                <Button Width="44" Height="44" Margin="4,0"
                        ToolTip.Tip="{Binding ModeSwitchTip}"
                        Command="{Binding ToggleModeCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Data="{Binding ModeSwitchIcon}" Fill="{StaticResource AccentBrush}"
                          Width="22" Height="22" Stretch="Uniform"/>
                </Button>

                <!-- 分隔线 -->
                <Border Height="1" Margin="10,6" Background="{StaticResource CapsuleDividerBrush}"/>

                <!-- 主工具列表：ItemsControl 避免 WrapPanel 内 ListBox Measure 为 0 的初始化 bug -->
                <ItemsControl x:Name="PrimaryToolsList"
                              ItemsSource="{Binding ActivePrimaryTools}"
                              Background="Transparent" Margin="4,0" Padding="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ToolActionViewModel">
                            <Button Width="40" Height="40" Margin="0,2"
                                    ToolTip.Tip="{Binding ToolTip}"
                                    Command="{Binding $parent[UserControl].DataContext.SelectToolCommand}"
                                    CommandParameter="{Binding Key}"
                                    Background="Transparent" BorderThickness="0"
                                    CornerRadius="12" Padding="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="CornerRadius" Value="12"/>
                                    </Style>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{StaticResource CapsuleHoverBrush}"/>
                                    </Style>
                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{StaticResource CapsuleSelectedBrush}"/>
                                    </Style>
                                </Button.Styles>
                                <Grid Width="40" Height="40">
                                    <!-- 单选互斥工具：左侧高亮竖条 -->
                                    <Border Width="3" Height="20" CornerRadius="0,2,2,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{StaticResource AccentBrush}"
                                            IsVisible="{Binding ShowSelectionBar}"/>
                                    <!-- 开关工具（laser 等）：圆角高亮背景块 -->
                                    <Border Width="32" Height="32" CornerRadius="10"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{StaticResource AccentBrush}"
                                            Opacity="0.22"
                                            IsVisible="{Binding ShowToggleBackground}"/>
                                    <Path Data="{Binding IconPath}"
                                          Fill="{Binding Foreground}"
                                          Width="20" Height="20" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsVisible="{Binding HasIconPath}"/>
                                    <TextBlock Text="{Binding Icon}" Foreground="{Binding Foreground}"
                                               FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding !HasIconPath}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             形状子工具胶囊（仅在形状工具激活时显示，与枭熊2对齐）
             四类：直线 / 常用形状 / 桌游常用形状 / 锚点多边形
             ════════════════════════════════════════════════════════════ -->
        <Border x:Name="ShapeSubToolCapsule"
                layout:SubToolLayout.TriggerKey="shape"
                ZIndex="45"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="24"
                Background="{StaticResource CapsuleToolbarBrush}"
                BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="1"
                BoxShadow="{StaticResource ShadowCapsule}"
                Padding="6,8"
                IsVisible="{Binding IsShapeToolActive}">

            <StackPanel Orientation="Vertical" Spacing="2">
                <ItemsControl ItemsSource="{Binding ShapeSubTools}"
                              Background="Transparent" Padding="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ShapeSubToolViewModel">
                            <StackPanel Orientation="Vertical">
                                <!-- 分类标题（每类首项显示） -->
                                <TextBlock Text="{Binding Category}"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           Margin="2,6,2,2"
                                           IsVisible="{Binding IsCategoryHeaderVisible}"/>
                                <Button Width="34" Height="34" Margin="0,1"
                                        ToolTip.Tip="{Binding ToolTip}"
                                        Command="{Binding $parent[UserControl].DataContext.SelectShapeSubToolCommand}"
                                        CommandParameter="{Binding Key}"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <Grid Width="34" Height="34">
                                        <Border CornerRadius="10"
                                                Background="{StaticResource CapsuleSelectedBrush}"
                                                IsVisible="{Binding IsSelected}"/>
                                        <Path Data="{Binding IconPath}"
                                              Fill="{Binding Foreground}"
                                              Width="18" Height="18" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsVisible="{Binding HasIconPath}"/>
                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding Foreground}"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding !HasIconPath}"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1" Margin="6,6" Background="{StaticResource CapsuleDividerBrush}"/>

                <!-- 填充开关 -->
                <Button Width="34" Height="34" ToolTip.Tip="切换填充（选中形状 / 新建默认）"
                        Command="{Binding ToggleShapeFillCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Data="M19,11.5C19,11.5 17,13.67 17,15A2,2 0 0,0 19,17A2,2 0 0,0 21,15C21,13.67 19,11.5 19,11.5M5.21,10L10,5.21L14.79,10M16.56,8.94L7.62,0L6.21,1.41L8.59,3.79L3.44,8.94C2.85,9.5 2.85,10.47 3.44,11.06L8.94,16.56C9.23,16.85 9.62,17 10,17C10.38,17 10.77,16.85 11.06,16.56L16.56,11.06C17.15,10.47 17.15,9.5 16.56,8.94Z"
                          Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>

                <!-- 线型循环 -->
                <Button Width="34" Height="34" ToolTip.Tip="切换线型：实线 / 虚线 / 点线"
                        Command="{Binding CycleStrokeStyleCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Data="M2,11H4V13H2V11M6,11H12V13H6V11M14,11H20V13H14V11M22,11H24V13H22V11M2,7H8V9H2V7M10,7H16V9H10V7M18,7H24V9H18V7M2,15H6V17H2V15M8,15H14V17H8V15M16,15H24V17H16V15Z"
                          Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             拓扑子工具胶囊（仅 graph 工具激活时显示）
             node = 点空白建节点；link = 从节点拖到节点建连线
             ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="GraphSubToolCapsule"
                layout:SubToolLayout.TriggerKey="graph"
                ZIndex="45"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="24"
                Background="{StaticResource CapsuleToolbarBrush}"
                BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="1"
                BoxShadow="{StaticResource ShadowCapsule}"
                Padding="6,8"
                IsVisible="{Binding IsGraphToolActive}">

            <StackPanel Orientation="Vertical" Spacing="2">
                <!-- 建节点 -->
                <Button Width="34" Height="34" Margin="0,1"
                        ToolTip.Tip="建节点（点击空白处创建，点已有节点则选中）"
                        Command="{Binding SelectGraphSubToolCommand}" CommandParameter="node"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Grid Width="34" Height="34">
                        <Border CornerRadius="10"
                                Background="{StaticResource CapsuleSelectedBrush}"
                                IsVisible="{Binding IsGraphNodeSubTool}"/>
                        <TextBlock Text="⬤" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- 拉连线 -->
                <Button Width="34" Height="34" Margin="0,1"
                        ToolTip.Tip="拉连线（从一个节点按住拖到另一个节点）"
                        Command="{Binding SelectGraphSubToolCommand}" CommandParameter="link"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Grid Width="34" Height="34">
                        <Border CornerRadius="10"
                                Background="{StaticResource CapsuleSelectedBrush}"
                                IsVisible="{Binding IsGraphLinkSubTool}"/>
                        <TextBlock Text="🔗" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Border Height="1" Margin="6,6" Background="{StaticResource CapsuleDividerBrush}"/>

                <!-- 清理悬空连线 -->
                <Button Width="34" Height="34" Margin="0,1"
                        ToolTip.Tip="清理悬空连线（目标节点已被删除的边）"
                        Command="{Binding PruneDanglingGraphLinksCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="🧹" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             迷雾子工具胶囊（仅 fog 工具激活时显示）
             ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="FogSubToolCapsule"
                layout:SubToolLayout.TriggerKey="fog"
                ZIndex="45"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="24"
                Background="{StaticResource CapsuleToolbarBrush}"
                BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="1"
                BoxShadow="{StaticResource ShadowCapsule}"
                Padding="6,8"
                IsVisible="{Binding IsFogToolActive}">
            <StackPanel Orientation="Vertical" Spacing="2">

                <!-- 开关迷雾 -->
                <Button Width="34" Height="34"
                        ToolTip.Tip="{Binding FogToggleTip}"
                        Command="{Binding ToggleFogCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Grid Width="34" Height="34">
                        <Border CornerRadius="10" Background="{StaticResource CapsuleSelectedBrush}"
                                IsVisible="{Binding IsFogEnabled}"/>
                        <Path Data="M6,19A5,5 0 0,1 1,14A5,5 0 0,1 6,9C7,6.65 9.3,5 12,5A6,6 0 0,1 18,11A4,4 0 0,1 22,15A4,4 0 0,1 18,19H6Z"
                              Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                    </Grid>
                </Button>

                <Border Height="1" Margin="6,4" Background="{StaticResource CapsuleDividerBrush}"/>

                <!-- 擦除（揭示）模式 -->
                <Button Width="34" Height="34"
                        ToolTip.Tip="擦除迷雾（揭示区域）"
                        Command="{Binding SetFogSubModeCommand}"
                        CommandParameter="erase"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Grid Width="34" Height="34">
                        <Border CornerRadius="10" Background="{StaticResource CapsuleSelectedBrush}"
                                IsVisible="{Binding IsFogEraseModeActive}"/>
                        <Path Data="M9.64,7.64C9.87,7.14 10,6.59 10,6A4,4 0 0,0 6,2A4,4 0 0,0 2,6A4,4 0 0,0 6,10C6.59,10 7.14,9.87 7.64,9.64L10,12L7.64,14.36C7.14,14.13 6.59,14 6,14A4,4 0 0,0 2,18A4,4 0 0,0 6,22A4,4 0 0,0 10,18C10,17.41 9.87,16.86 9.64,16.36L12,14L19.36,21.36L20.78,19.95L4.05,3.22L2.64,4.64L4.97,6.97C4.95,6.98 4.94,7 4.93,7.01L7.64,9.64M6,8A2,2 0 0,1 4,6A2,2 0 0,1 6,4A2,2 0 0,1 8,6A2,2 0 0,1 6,8M6,20A2,2 0 0,1 4,18A2,2 0 0,1 6,16A2,2 0 0,1 8,18A2,2 0 0,1 6,20M12,10A2,2 0 0,1 10,12A2,2 0 0,1 12,14A2,2 0 0,1 14,12A2,2 0 0,1 12,10Z"
                              Fill="#F59E0B" Width="18" Height="18" Stretch="Uniform"/>
                    </Grid>
                </Button>

                <!-- 绘制（遮挡）模式 -->
                <Button Width="34" Height="34"
                        ToolTip.Tip="绘制迷雾（遮挡区域）"
                        Command="{Binding SetFogSubModeCommand}"
                        CommandParameter="paint"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Grid Width="34" Height="34">
                        <Border CornerRadius="10" Background="{StaticResource CapsuleSelectedBrush}"
                                IsVisible="{Binding IsFogPaintModeActive}"/>
                        <Path Data="M20.71,4.04C21.1,3.65 21.1,3 20.71,2.63L18.37,0.29C18,-0.1 17.35,-0.1 16.96,0.29L15.12,2.12L18.87,5.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                              Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                    </Grid>
                </Button>

                <Border Height="1" Margin="6,4" Background="{StaticResource CapsuleDividerBrush}"/>

                <!-- 揭示全图 -->
                <Button Width="34" Height="34"
                        ToolTip.Tip="揭示全图"
                        Command="{Binding FogRevealAllCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                          Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>

                <!-- 全图遮挡 -->
                <Button Width="34" Height="34"
                        ToolTip.Tip="全图遮挡（清除所有揭示）"
                        Command="{Binding FogClearAllCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Data="M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,4.5C17,4.5 21.27,7.61 23,12C22.18,14.08 20.79,15.88 19,17.19L17.58,15.76C18.94,14.82 20.06,13.54 20.82,12C19.17,8.64 15.76,6.5 12,6.5C10.91,6.5 9.84,6.68 8.84,7L7.3,5.47C8.74,4.85 10.33,4.5 12,4.5Z"
                          Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>

            </StackPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             左下设置胶囊（只含设置按钮）
             随 BottomDrawer 开关向上推移，Margin 由 DrawerLayoutBehavior 管理
             ════════════════════════════════════════════════════════════ -->
        <Border x:Name="ActionCapsule"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="14,0,0,14" ZIndex="40"
                CornerRadius="20"
                Background="{StaticResource CapsuleActionBrush}"
                BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="1"
                BoxShadow="{StaticResource ShadowCapsuleAction}"
                Padding="6,6">
            <Border.Transitions>
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <Border.Styles>
                <Style Selector="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="CornerRadius" Value="14"/>
                </Style>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{StaticResource CapsuleHoverBrush}"/>
                </Style>
                <Style Selector="Button:pressed /template/ ContentPresenter">
                    <Setter Property="Background" Value="{StaticResource CapsuleSelectedBrush}"/>
                </Style>
                <Style Selector="Button:disabled /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Opacity" Value="0.35"/>
                </Style>
            </Border.Styles>

            <StackPanel Orientation="Vertical" Spacing="2">
                <!-- 全局设置 -->
                <Button Width="36" Height="36" ToolTip.Tip="全局设置"
                        Command="{Binding OpenSettingsCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Data="{StaticResource IconCog}"
                          Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             右上面板切换胶囊（随 RightDrawer 左移，随 BottomDrawer 底部压缩）
             内容：层级 / Inspector / 素材库 / 先攻 / 骰子 / 保存
             竖列排列，满列换列继续排
             ════════════════════════════════════════════════════════════════ -->
        <Border x:Name="PanelToggleCapsule"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,14,14,62" ZIndex="30"
                CornerRadius="20"
                Background="{StaticResource CapsuleActionBrush}"
                BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="1"
                BoxShadow="{StaticResource ShadowCapsuleAction}"
                Padding="6,6">
            <Border.Transitions>
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <Border.Styles>
                <Style Selector="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="CornerRadius" Value="14"/>
                </Style>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{StaticResource CapsuleHoverBrush}"/>
                </Style>
                <Style Selector="Button:pressed /template/ ContentPresenter">
                    <Setter Property="Background" Value="{StaticResource CapsuleSelectedBrush}"/>
                </Style>
            </Border.Styles>

            <!-- WrapPanel Vertical：按钮竖向排列，超出高度自动换列 -->
            <WrapPanel Orientation="Vertical">
                <!-- 场景层级 -->
                <Button Width="36" Height="36" Margin="0,0,0,2" ToolTip.Tip="场景层级"
                        Command="{Binding ToggleLeftDrawerCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Data="{StaticResource IconLayers}"
                          Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>
                <!-- Inspector -->
                <Button Width="36" Height="36" ToolTip.Tip="属性检视器"
                        Command="{Binding ToggleRightDrawerCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Data="{StaticResource IconTune}"
                          Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>
                <!-- 素材库 -->
                <Button Width="36" Height="36" ToolTip.Tip="素材库"
                        Command="{Binding ToggleBottomDrawerCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Data="{StaticResource IconFolderMultiple}"
                          Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>

                <!-- 分隔线 -->
                <Border Height="1" Width="28" Margin="4,2"
                        Background="{StaticResource CapsuleDividerBrush}"/>

                <!-- 先攻追踪器 -->
                <Button Width="36" Height="36" ToolTip.Tip="先攻追踪器 (I)"
                        Command="{Binding ToggleTopDrawerCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="⚔️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- 骰子面板 -->
                <Button Width="36" Height="36" ToolTip.Tip="骰子 (Dice)"
                        Command="{Binding ToggleDicePanelCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="🎲" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- 分隔线 -->
                <Border Height="1" Width="28" Margin="4,2"
                        Background="{StaticResource CapsuleDividerBrush}"/>

                <!-- 保存 -->
                <Button Width="36" Height="36" ToolTip.Tip="保存场景 (Ctrl+S)"
                        Command="{Binding SaveSceneCommand}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Data="{StaticResource IconSave}"
                          Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>
                <!-- 在线保存（预留） -->
                <Button Width="36" Height="36" ToolTip.Tip="在线保存（需联机房间）"
                        IsEnabled="False"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Data="{StaticResource IconCloudUpload}"
                          Fill="{StaticResource TextMutedBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>
            </WrapPanel>
        </Border>

        <!-- ── 状态栏（左下，跟随 ActionCapsule 让位）─────────────────── -->
        <Border x:Name="StatusBarCapsule"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="62,0,0,14" ZIndex="5"
                Padding="10,6" Background="{StaticResource FloatingPanelBrush}"
                CornerRadius="10"
                BoxShadow="0 4 12 0 #80000000">
            <Border.Transitions>
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding StatusMessage}"          Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                <TextBlock Text="{Binding MapViewportSummary}"     Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"/>
                <TextBlock Text="{Binding GraphicsRuntimeSummary}" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                <TextBlock Text="{Binding GraphicsRuntimeHint}"    Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             左侧抽屉：场景层级树（全高胶囊，为 ActionCapsule + BottomDrawer 让位）
             ════════════════════════════════════════════════════════════════ -->
        <Border x:Name="LeftDrawer"
                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Width="260" Margin="0,14,0,62" ZIndex="10"
                CornerRadius="14"
                Background="{StaticResource DrawerBackgroundBrush}"
                BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="1"
                BoxShadow="4 0 24 0 #A0000000, 1 0 6 0 #30845EF7"
                ClipToBounds="False">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <Border.Styles>
                <Style Selector="Border#LeftDrawer">
                    <Setter Property="RenderTransform" Value="translateX(-260px)"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </Style>
                <Style Selector="Border#LeftDrawer.open">
                    <Setter Property="RenderTransform" Value="translateX(0px)"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </Style>
                <!-- Margin 由 DrawerLayoutBehavior 动态管理 -->
            </Border.Styles>
            <Grid RowDefinitions="36,*,Auto">
                <Border Grid.Row="0" Background="{StaticResource CapsuleActionBrush}" Padding="10,0"
                        BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <Path Grid.Column="0" Data="{StaticResource IconLayers}"
                              Fill="{StaticResource TextTertiaryBrush}" Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="场景层级" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" FontSize="12"/>
                        <!-- 保存场景按钮 -->
                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                Width="24" Height="24" Padding="0" CornerRadius="12"
                                Margin="0,0,4,0"
                                ToolTip.Tip="保存场景 (Ctrl+S)" Command="{Binding SaveSceneCommand}">
                            <Path Data="{StaticResource IconSave}"
                                  Fill="{StaticResource TextTertiaryBrush}" Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- 加载场景按钮 -->
                        <Button Grid.Column="3" Background="Transparent" BorderThickness="0"
                                Width="24" Height="24" Padding="0" CornerRadius="12"
                                Margin="0,0,4,0"
                                ToolTip.Tip="加载场景 (Ctrl+O)" Click="LoadScene_Click">
                            <Path Data="{StaticResource IconFolderOpen}"
                                  Fill="{StaticResource TextTertiaryBrush}" Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- 关闭按钮 -->
                        <Button Grid.Column="4" Background="Transparent" BorderThickness="0"
                                Width="24" Height="24" Padding="0" CornerRadius="12"
                                ToolTip.Tip="关闭" Command="{Binding ToggleLeftDrawerCommand}">
                            <Path Data="{StaticResource IconClose}"
                                  Fill="{StaticResource TextTertiaryBrush}" Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="LeftTreeScroll"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              AllowAutoHide="True">
                    <TreeView x:Name="HierarchyTreeView"
                              Margin="10" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                              ItemsSource="{Binding HierarchyRoots}"
                              SelectedItem="{Binding SelectedHierarchyItem, Mode=TwoWay}"
                              DragDrop.AllowDrop="True"
                              DragDrop.DragOver="HierarchyRoot_DragOver"
                              DragDrop.Drop="HierarchyRoot_Drop">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="新建空对象"  Click="AddRootEmptyObject_Click"/>
                                <MenuItem Header="新建墙壁" Click="AddRootWallObject_Click"/>
                                <Separator/>
                                <MenuItem Header="粘贴" Click="PasteHierarchyToRoot_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </ScrollViewer>
                <Border Grid.Row="2" x:Name="LeftSelectionInfo"
                        Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="0,1,0,0"
                        Padding="10,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="当前选中" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding CurrentSelectionDisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentSelectionType}"   Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding CurrentSelectionHint}"   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                        <Button Content="导航到位置" Command="{Binding NavigateToSelectionCommand}"
                                Background="{StaticResource ThumbnailBackgroundBrush}" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                Foreground="{StaticResource TextPrimaryBrush}" CornerRadius="4" Padding="8,4"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             右侧抽屉：Inspector（全高胶囊，为 BottomDrawer 让位）
             ════════════════════════════════════════════════════════════════ -->
        <Border x:Name="RightDrawer"
                HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Width="320" Margin="0,14,14,62" ZIndex="10"
                CornerRadius="14"
                Background="{StaticResource DrawerBackgroundBrush}"
                BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="1"
                BoxShadow="-4 0 24 0 #A0000000, -1 0 6 0 #30845EF7"
                ClipToBounds="False">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <Border.Styles>
                <Style Selector="Border#RightDrawer">
                    <Setter Property="RenderTransform" Value="translateX(320px)"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </Style>
                <Style Selector="Border#RightDrawer.open">
                    <Setter Property="RenderTransform" Value="translateX(0px)"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </Style>
                <!-- Margin 由 DrawerLayoutBehavior 动态管理 -->
            </Border.Styles>
            <Grid RowDefinitions="36,*">
                <Border Grid.Row="0" Background="{StaticResource CapsuleActionBrush}"
                        BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Path Grid.Column="0" Data="{StaticResource IconTune}"
                              Fill="{StaticResource TextTertiaryBrush}" Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" x:Name="RightHeaderText"
                                   Text="Inspector" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" x:Name="RightMenuButton"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                Width="24" Height="24" CornerRadius="12"
                                ToolTip.Tip="更多选项"
                                Command="{Binding ShowInspectorMenuCommand}">
                            <Path Data="{StaticResource IconDotsVertical}"
                                  Fill="{StaticResource TextTertiaryBrush}" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="3" Background="Transparent" BorderThickness="0"
                                Width="24" Height="24" Padding="0" CornerRadius="12"
                                ToolTip.Tip="关闭" Command="{Binding ToggleRightDrawerCommand}">
                            <Path Data="{StaticResource IconClose}"
                                  Fill="{StaticResource TextTertiaryBrush}" Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="RightContentScroll"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              AllowAutoHide="True">
                    <StackPanel Spacing="0" IsVisible="{Binding SelectedHierarchyItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <!-- 对象头部 -->
                        <Border Background="{StaticResource PanelElevatedBrush}" Padding="10,8" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="0,0,0,1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding SelectedHierarchyItem.Icon}" FontSize="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedHierarchyItem.DisplayName}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedHierarchyItem.ObjectType}"
                                           Foreground="{StaticResource TextTertiaryBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedHierarchyItem.InstanceId}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <!-- 组件列表（ComponentEditors 数据驱动） -->
                        <ItemsControl ItemsSource="{Binding SelectedHierarchyItem.ComponentEditors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ComponentEditorViewModel">
                                    <Border Margin="0,0,0,1"
                                            Background="{StaticResource DrawerBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <!-- 组件标题栏 -->
                                            <Border Padding="10,6" Background="{StaticResource PanelElevatedBrush}">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <Path Grid.Column="0" Data="{Binding IconPath}"
                                                          Fill="{StaticResource TextTertiaryBrush}"
                                                          Width="15" Height="15" Stretch="Uniform"
                                                          VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                               Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2"
                                                            Background="Transparent" BorderThickness="0" Padding="4,2"
                                                            ToolTip.Tip="折叠/展开"
                                                            Command="{Binding ToggleExpandCommand}">
                                                        <Panel>
                                                            <Path Data="{StaticResource IconChevronDown}"
                                                                  Fill="{StaticResource TextTertiaryBrush}" Width="14" Height="14" Stretch="Uniform"
                                                                  IsVisible="{Binding IsExpanded}"/>
                                                            <Path Data="{StaticResource IconChevronRight}"
                                                                  Fill="{StaticResource TextTertiaryBrush}" Width="14" Height="14" Stretch="Uniform"
                                                                  IsVisible="{Binding !IsExpanded}"/>
                                                        </Panel>
                                                    </Button>
                                                    <Button Grid.Column="3"
                                                            IsVisible="{Binding CanRemove}"
                                                            Background="Transparent" BorderThickness="0" Padding="4,2"
                                                            ToolTip.Tip="移除组件"
                                                            Command="{Binding RemoveCommand}">
                                                        <Path Data="{StaticResource IconClose}"
                                                              Fill="{StaticResource DangerBrush}" Width="12" Height="12" Stretch="Uniform"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <!-- 组件字段（按 IsExpanded 显隐） -->
                                            <StackPanel IsVisible="{Binding IsExpanded}" Spacing="0" Margin="0,2,0,4">
                                                <ContentControl Content="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Component 按钮 -->
                        <Border Padding="10,8">
                            <Button Content="+ 添加组件" Click="AddComponent_Click"
                                    HorizontalAlignment="Stretch"
                                    Background="{StaticResource ThumbnailBackgroundBrush}" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                    Foreground="{StaticResource TextSecondaryBrush}" CornerRadius="4" Padding="0,6"/>
                        </Border>

                        <!-- 标签管理 -->
                        <Border Padding="10,8" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="0,1,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="标签" Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" FontWeight="SemiBold"/>

                                <!-- 输入框：快速添加 Tag -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding NewTagText, Mode=TwoWay}"
                                             PlaceholderText="输入标签..."
                                             FontSize="11"
                                             Background="{StaticResource ToolbarBackgroundBrush}"
                                             BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             CornerRadius="4" Padding="6,3"
                                             KeyDown="TagTextBox_KeyDown"/>
                                    <Button Grid.Column="1" Margin="4,0,0,0"
                                            Background="{StaticResource CapsulePurpleBrush}"
                                            BorderThickness="0" CornerRadius="4"
                                            Padding="8,3" FontSize="11"
                                            Foreground="White"
                                            Command="{Binding AddTagCommand}"
                                            ToolTip.Tip="添加标签 (Enter)">
                                        <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Stretch="Uniform"
                                              Fill="White" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>

                                <!-- Tag 芯片列表 -->
                                <ItemsControl ItemsSource="{Binding SelectedHierarchyItem.Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CapsulePurpleBrush}"
                                                    CornerRadius="12" Padding="9,4" Margin="2,1">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                                                    <Button Background="Transparent" BorderThickness="0"
                                                            Padding="0" Width="13" Height="13"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="移除"
                                                            Command="{Binding #Root.DataContext.RemoveTagCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconClose}"
                                                              Fill="White" Width="8" Height="8" Stretch="Uniform"
                                                              Opacity="0.85"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 空态提示 -->
                                <TextBlock IsVisible="{Binding SelectedHierarchyItem.Tags.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                                           Text="暂无标签" FontSize="10" FontStyle="Italic"
                                           Foreground="{StaticResource TextTertiaryBrush}" Margin="2,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             底部抽屉：素材库（胶囊风格，脱离边缘，随左右抽屉压缩高度）
             ════════════════════════════════════════════════════════════════ -->
        <Border x:Name="BottomDrawer"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                Height="280" Margin="14,0,14,14" ZIndex="10"
                CornerRadius="14"
                Background="{StaticResource DrawerBackgroundBrush}"
                BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="1"
                BoxShadow="0 -4 24 0 #A0000000, 0 -1 6 0 #30845EF7"
                ClipToBounds="False">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <Border.Styles>
                <Style Selector="Border#BottomDrawer">
                    <Setter Property="RenderTransform" Value="translateY(280px)"/>
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </Style>
                <Style Selector="Border#BottomDrawer.open">
                    <Setter Property="RenderTransform" Value="translateY(0px)"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </Style>
            </Border.Styles>

            <Grid RowDefinitions="36,*">
                <!-- 标题栏：素材库专用 -->
                <Border Grid.Row="0" Background="{StaticResource CapsuleActionBrush}"
                        BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                        <Path Grid.Column="0" Data="{StaticResource IconFolderMultiple}"
                              Fill="{StaticResource TextTertiaryBrush}" Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="素材库"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="AssetSearchBox"
                                 Text="{Binding AssetSearchText, Mode=TwoWay}"
                                 PlaceholderText="搜索素材…"
                                 Margin="10,4" Padding="6,2"
                                 Background="{StaticResource ToolbarBackgroundBrush}" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                 Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" CornerRadius="10"/>

                        <!-- 本地/房间切换 -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="8,0" VerticalAlignment="Center">
                            <RadioButton Content="本地" FontSize="10" Padding="8,2"
                                         IsChecked="{Binding IsLocalAssetSourceActive, Mode=TwoWay}"
                                         ToolTip.Tip="使用本地素材库（跨房间复用）"/>
                            <RadioButton Content="房间" FontSize="10" Padding="8,2"
                                         IsChecked="{Binding IsRoomAssetSourceActive, Mode=TwoWay}"
                                         IsEnabled="{Binding IsRoomAssetLibraryAvailable}"
                                         ToolTip.Tip="使用房间素材库（房间成员共享）"/>
                        </StackPanel>

                        <TextBlock Grid.Column="4"
                                   Text="{Binding AssetBreadcrumb}"
                                   Foreground="{StaticResource TextTertiaryBrush}" FontSize="11" Margin="8,0"
                                   VerticalAlignment="Center"/>
                        <Slider Grid.Column="5"
                                Minimum="48" Maximum="128"
                                Value="{Binding AssetThumbnailSize, Mode=TwoWay}"
                                Width="80" Margin="8,0" VerticalAlignment="Center"
                                ToolTip.Tip="缩略图大小"/>
                        <Button Grid.Column="6" Background="Transparent" BorderThickness="0"
                                Width="24" Height="24" Padding="0" CornerRadius="12"
                                ToolTip.Tip="关闭" Command="{Binding ToggleBottomDrawerCommand}">
                            <Path Data="{StaticResource IconClose}"
                                  Fill="{StaticResource TextTertiaryBrush}" Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 内容区：素材库面板 -->
                <Grid Grid.Row="1" ColumnDefinitions="180,*"
                      DragDrop.AllowDrop="True" DragDrop.Drop="AssetLibrary_Drop">
                        <!-- 文件夹树 -->
                        <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="0,0,1,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <TreeView Margin="8"
                                          Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                          ItemsSource="{Binding AssetRoots}"
                                          SelectedItem="{Binding SelectedAssetFolder, Mode=TwoWay}"/>
                            </ScrollViewer>
                        </Border>
                        <!-- 素材卡片区：子文件夹 + 文件，全部平铺 -->
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8" Spacing="0">

                                <!-- 子文件夹行（仅当前目录的直接子目录） -->
                                <ItemsControl ItemsSource="{Binding SelectedAssetFolder.Children}"
                                              IsVisible="{Binding SelectedAssetFolder.Children.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:AssetFolderViewModel">
                                            <Border Width="{Binding #Root.DataContext.AssetTileWidth}"
                                                    Margin="5" Padding="8"
                                                    Background="{StaticResource PanelElevatedBrush}" BorderBrush="{StaticResource BorderBrushToken}" BorderThickness="1"
                                                    CornerRadius="6"
                                                    PointerPressed="AssetFolderCard_PointerPressed">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="打开文件夹"       Click="OpenAssetFolderCard_Click"      CommandParameter="{Binding .}"/>
                                                        <Separator/>
                                                        <MenuItem Header="新增文件夹"       Click="AddAssetFolder_Click"           CommandParameter="{Binding .}"/>
                                                        <MenuItem Header="新增静态对象类"   Click="AddAssetItem_Click"             CommandParameter="{Binding .}"/>
                                                        <Separator/>
                                                        <MenuItem Header="复制"            Click="CopyAssetFolder_Click"          CommandParameter="{Binding .}"/>
                                                        <MenuItem Header="粘贴文件夹"      Click="PasteAssetFolder_Click"         CommandParameter="{Binding .}"/>
                                                        <MenuItem Header="粘贴对象类"      Click="PasteAssetItemIntoFolder_Click" CommandParameter="{Binding .}"/>
                                                        <MenuItem Header="复制副本"        Click="DuplicateAssetFolder_Click"     CommandParameter="{Binding .}"/>
                                                        <Separator/>
                                                        <MenuItem Header="重命名"          Click="RenameAssetFolder_Click"        CommandParameter="{Binding .}"/>
                                                        <MenuItem Header="删除"            Click="DeleteAssetFolder_Click"        CommandParameter="{Binding .}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <StackPanel Spacing="6">
                                                    <Border Height="{Binding #Root.DataContext.AssetThumbnailSize}"
                                                            Background="{StaticResource ThumbnailBackgroundBrush}" CornerRadius="4">
                                                        <Path Data="{StaticResource IconFolder}"
                                                              Fill="{StaticResource FolderAccentBrush}" Width="34" Height="34" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource FolderAccentBrush}"
                                                               TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ChildCountLabel}" Foreground="{StaticResource TextTertiaryBrush}"
                                                               FontSize="11" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 素材文件卡片（WrapPanel 直接作为面板，宽度不受嵌套限制） -->
                                <ItemsControl ItemsSource="{Binding VisibleAssetItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding #Root.DataContext.AssetCardWidth}"
                                                    Margin="6" Padding="8" Background="{StaticResource AssetCardBrush}" CornerRadius="6"
                                                    Cursor="Hand" PointerPressed="AssetItemCard_PointerPressed">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="复制" Click="CopyAssetItem_Click" CommandParameter="{Binding .}"/>
                                                        <MenuItem Header="粘贴" Click="PasteAssetItem_Click" CommandParameter="{Binding .}"/>
                                                        <MenuItem Header="复制副本" Click="DuplicateAssetItem_Click" CommandParameter="{Binding .}"/>
                                                        <Separator/>
                                                        <MenuItem Header="重命名" Click="RenameAssetItem_Click" CommandParameter="{Binding .}"/>
                                                        <MenuItem Header="删除" Click="DeleteAssetItem_Click" CommandParameter="{Binding .}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <StackPanel Spacing="6">
                                                    <Border Height="{Binding #Root.DataContext.AssetThumbnailSize}"
                                                            Background="{StaticResource ThumbnailBackgroundBrush}" CornerRadius="4">
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Kind}" Foreground="{StaticResource TextTertiaryBrush}"
                                                               FontSize="11" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid> <!-- 结束 Grid Grid.Row="1" ColumnDefinitions="180,*" -->
                </Grid> <!-- 结束 Grid RowDefinitions="36,*" -->
        </Border>

        <!-- ── 视口控制胶囊（右下，双行 Owlbear 风格）─────────────────── -->
        <!--
             行 1: [▦网格] [🧲吸附] │ [⌖回原点]
             行 2: [1格=5ft ▾]      │ [−] [100%▾] [+]
             Margin 由 DrawerLayoutBehavior 动态管理
        -->
        <Border x:Name="ViewportCapsule"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,14,14" ZIndex="30"
                Background="{StaticResource CapsuleActionBrush}"
                CornerRadius="14"
                BorderBrush="{StaticResource CapsuleBorderBrush}" BorderThickness="1"
                BoxShadow="{StaticResource ShadowCapsuleAction}">
            <Border.Transitions>
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <!-- Margin 由 DrawerLayoutBehavior 动态管理；无 pushed-right/pushed-up class styles -->
            <StackPanel Orientation="Vertical" Spacing="0">

                <!-- 行 1: 工具开关 + 回原点 -->
                <StackPanel Orientation="Horizontal" Spacing="0" Margin="4,4,4,0">

                    <!-- 网格开关 -->
                    <Button Background="Transparent" BorderThickness="0"
                            CornerRadius="10" Width="32" Height="28" Padding="0"
                            ToolTip.Tip="显示/隐藏网格 (G)"
                            Command="{Binding ToggleGridCommand}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{StaticResource CapsuleSelectedBrush}"/>
                            </Style>
                        </Button.Styles>
                        <Panel>
                            <!-- 网格开：ShowGrid=True -->
                            <Path Data="{StaticResource IconGrid}" Width="15" Height="15" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding ShowGrid}"
                                  Fill="{StaticResource CapsulePurpleBrush}"/>
                            <!-- 网格关：ShowGrid=False -->
                            <Path Data="{StaticResource IconGridOff}" Width="15" Height="15" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding !ShowGrid}"
                                  Fill="{StaticResource TextTertiaryBrush}"/>
                        </Panel>
                    </Button>

                    <!-- 吸附开关 -->
                    <Button Background="Transparent" BorderThickness="0"
                            CornerRadius="10" Width="32" Height="28" Padding="0"
                            ToolTip.Tip="格子吸附 (S)"
                            Command="{Binding ToggleSnapCommand}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{StaticResource CapsuleSelectedBrush}"/>
                            </Style>
                        </Button.Styles>
                        <Panel>
                            <!-- 吸附开 -->
                            <Path Data="{StaticResource IconMagnet}" Width="15" Height="15" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding IsSnapToGrid}"
                                  Fill="{StaticResource CapsulePurpleBrush}"/>
                            <!-- 吸附关 -->
                            <Path Data="{StaticResource IconMagnetOff}" Width="15" Height="15" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsVisible="{Binding !IsSnapToGrid}"
                                  Fill="{StaticResource TextTertiaryBrush}"/>
                        </Panel>
                    </Button>

                    <!-- 分隔线 -->
                    <Border Width="1" Height="16" Margin="4,0"
                            Background="{StaticResource CapsuleBorderBrush}" VerticalAlignment="Center"/>

                    <!-- 回原点 -->
                    <Button Background="Transparent" BorderThickness="0"
                            CornerRadius="10" Width="32" Height="28" Padding="0"
                            ToolTip.Tip="视野回原点 (Home)"
                            Command="{Binding ResetViewCommand}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{StaticResource CapsuleSelectedBrush}"/>
                            </Style>
                        </Button.Styles>
                        <Path Data="{StaticResource IconCrosshairsGps}" Width="15" Height="15" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{StaticResource TextSecondaryBrush}"/>
                    </Button>

                </StackPanel>

                <!-- 行间分隔 -->
                <Border Height="1" Margin="8,3,8,3"
                        Background="{StaticResource CapsuleBorderBrush}"/>

                <!-- 行 2: 比例尺 + 缩放条 -->
                <StackPanel Orientation="Horizontal" Spacing="0" Margin="4,0,4,4">

                    <!-- 比例尺预设弹出按钮 -->
                    <Button Background="Transparent" BorderThickness="0"
                            CornerRadius="10" Height="28" Padding="6,0"
                            ToolTip.Tip="设置每格单位距离">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{StaticResource CapsuleSelectedBrush}"/>
                            </Style>
                        </Button.Styles>
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedLeft">
                                <MenuItem Header="5 ft / 格"   Command="{Binding SetScalePresetCommand}" CommandParameter="5"/>
                                <MenuItem Header="10 ft / 格"  Command="{Binding SetScalePresetCommand}" CommandParameter="10"/>
                                <MenuItem Header="15 ft / 格"  Command="{Binding SetScalePresetCommand}" CommandParameter="15"/>
                                <MenuItem Header="20 ft / 格"  Command="{Binding SetScalePresetCommand}" CommandParameter="20"/>
                                <MenuItem Header="30 ft / 格"  Command="{Binding SetScalePresetCommand}" CommandParameter="30"/>
                                <MenuItem Header="50 ft / 格"  Command="{Binding SetScalePresetCommand}" CommandParameter="50"/>
                                <MenuItem Header="100 ft / 格" Command="{Binding SetScalePresetCommand}" CommandParameter="100"/>
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="1格 =" FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ScaleText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IconChevronDown}" Width="8" Height="8" Stretch="Uniform"
                                  Fill="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 分隔线 -->
                    <Border Width="1" Height="16" Margin="4,0"
                            Background="{StaticResource CapsuleBorderBrush}" VerticalAlignment="Center"/>

                    <!-- 缩小 -->
                    <Button Background="Transparent" BorderThickness="0"
                            CornerRadius="10" Width="26" Height="28" Padding="0"
                            ToolTip.Tip="缩小 (−)"
                            Command="{Binding ZoomOutCommand}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{StaticResource CapsuleSelectedBrush}"/>
                            </Style>
                        </Button.Styles>
                        <Path Data="{StaticResource IconMinus}" Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{StaticResource TextSecondaryBrush}"/>
                    </Button>

                    <!-- 缩放比例弹出 -->
                    <Button Background="Transparent" BorderThickness="0"
                            CornerRadius="10" Height="28" Padding="6,0" MinWidth="52"
                            ToolTip.Tip="设置缩放比例">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{StaticResource CapsuleSelectedBrush}"/>
                            </Style>
                        </Button.Styles>
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                <MenuItem Header="2 %"    Command="{Binding SetZoomPresetCommand}" CommandParameter="0.02"/>
                                <MenuItem Header="5 %"    Command="{Binding SetZoomPresetCommand}" CommandParameter="0.05"/>
                                <MenuItem Header="10 %"   Command="{Binding SetZoomPresetCommand}" CommandParameter="0.10"/>
                                <MenuItem Header="25 %"   Command="{Binding SetZoomPresetCommand}" CommandParameter="0.25"/>
                                <MenuItem Header="50 %"   Command="{Binding SetZoomPresetCommand}" CommandParameter="0.50"/>
                                <MenuItem Header="100 %"  Command="{Binding SetZoomPresetCommand}" CommandParameter="1.0"/>
                                <MenuItem Header="200 %"  Command="{Binding SetZoomPresetCommand}" CommandParameter="2.0"/>
                                <MenuItem Header="400 %"  Command="{Binding SetZoomPresetCommand}" CommandParameter="4.0"/>
                                <MenuItem Header="800 %"  Command="{Binding SetZoomPresetCommand}" CommandParameter="8.0"/>
                                <MenuItem Header="1600 %" Command="{Binding SetZoomPresetCommand}" CommandParameter="16.0"/>
                                <MenuItem Header="6400 %" Command="{Binding SetZoomPresetCommand}" CommandParameter="64.0"/>
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="{Binding ZoomText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Path Data="{StaticResource IconChevronDown}" Width="8" Height="8" Stretch="Uniform"
                                  Fill="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 放大 -->
                    <Button Background="Transparent" BorderThickness="0"
                            CornerRadius="10" Width="26" Height="28" Padding="0"
                            ToolTip.Tip="放大 (+)"
                            Command="{Binding ZoomInCommand}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{StaticResource CapsuleSelectedBrush}"/>
                            </Style>
                        </Button.Styles>
                        <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{StaticResource TextSecondaryBrush}"/>
                    </Button>

                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
