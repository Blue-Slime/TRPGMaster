<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════
         Owlbear Rodeo 2 设计 token
         ════════════════════════════════════════════════════════════════ -->

    <!-- ── 背景层级 ────────────────────────────────────────────────── -->
    <Color x:Key="AppBackgroundColor">#1A1B1E</Color>
    <Color x:Key="ToolbarBackgroundColor">#141517</Color>
    <Color x:Key="DrawerBackgroundColor">#25262B</Color>
    <Color x:Key="DrawerHeaderColor">#2C2E33</Color>
    <Color x:Key="PanelElevatedColor">#2C2E33</Color>
    <Color x:Key="InputBackgroundColor">#1A1B1E</Color>
    <Color x:Key="CardBackgroundColor">#2C2E33</Color>
    <Color x:Key="ThumbnailBackgroundColor">#373A40</Color>

    <!-- ── 强调色（Mantine violet）────────────────────────────────── -->
    <Color x:Key="AccentColor">#845EF7</Color>
    <Color x:Key="AccentHoverColor">#9775FA</Color>
    <Color x:Key="AccentMutedColor">#5F3DC4</Color>
    <Color x:Key="SelectionColor">#3B3F76</Color>
    <Color x:Key="HoverColor">#2C2E33</Color>

    <!-- ── 边框 ────────────────────────────────────────────────────── -->
    <Color x:Key="BorderColor">#373A40</Color>
    <Color x:Key="BorderSubtleColor">#2C2E33</Color>

    <!-- ── 文字层级 ────────────────────────────────────────────────── -->
    <Color x:Key="TextPrimaryColor">#F8F9FA</Color>
    <Color x:Key="TextSecondaryColor">#C1C2C5</Color>
    <Color x:Key="TextTertiaryColor">#909296</Color>
    <Color x:Key="TextMutedColor">#5C5F66</Color>

    <!-- ── 语义色 ──────────────────────────────────────────────────── -->
    <Color x:Key="FolderAccentColor">#74C0FC</Color>
    <Color x:Key="SuccessColor">#51CF66</Color>
    <Color x:Key="DangerColor">#FF6B6B</Color>

    <!-- ── Brush 映射 ──────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AppBackgroundBrush"       Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush"   Color="{StaticResource ToolbarBackgroundColor}"/>
    <SolidColorBrush x:Key="DrawerBackgroundBrush"    Color="{StaticResource DrawerBackgroundColor}"/>
    <SolidColorBrush x:Key="DrawerHeaderBrush"        Color="{StaticResource DrawerHeaderColor}"/>
    <SolidColorBrush x:Key="PanelElevatedBrush"       Color="{StaticResource PanelElevatedColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush"     Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"      Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="ThumbnailBackgroundBrush" Color="{StaticResource ThumbnailBackgroundColor}"/>

    <SolidColorBrush x:Key="AccentBrush"              Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"         Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentMutedBrush"         Color="{StaticResource AccentMutedColor}"/>
    <SolidColorBrush x:Key="SelectionBrush"           Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="HoverBrush"               Color="{StaticResource HoverColor}"/>

    <SolidColorBrush x:Key="BorderBrushToken"         Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"        Color="{StaticResource BorderSubtleColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"         Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"       Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush"        Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"           Color="{StaticResource TextMutedColor}"/>

    <SolidColorBrush x:Key="FolderAccentBrush"        Color="{StaticResource FolderAccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"             Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush"              Color="{StaticResource DangerColor}"/>

    <!-- 半透明浮窗底色 -->
    <SolidColorBrush x:Key="FloatingPanelBrush"       Color="#25262B" Opacity="0.92"/>

    <!-- ── 毛玻璃胶囊 token ────────────────────────────────────────── -->
    <!-- 工具栏胶囊：深色 + 轻微透明 -->
    <SolidColorBrush x:Key="CapsuleToolbarBrush"      Color="#1C1D21" Opacity="0.96"/>
    <!-- 功能胶囊（底部）：略浅一档 -->
    <SolidColorBrush x:Key="CapsuleActionBrush"       Color="#25262B" Opacity="0.96"/>
    <!-- 胶囊描边：细蓝紫微光 -->
    <SolidColorBrush x:Key="CapsuleBorderBrush"       Color="#845EF7" Opacity="0.20"/>
    <!-- 胶囊内分隔线 -->
    <SolidColorBrush x:Key="CapsuleDividerBrush"      Color="#373A40" Opacity="0.80"/>
    <!-- 悬停内圈高亮 -->
    <SolidColorBrush x:Key="CapsuleHoverBrush"        Color="#845EF7" Opacity="0.12"/>
    <!-- 选中内圈 -->
    <SolidColorBrush x:Key="CapsuleSelectedBrush"     Color="#845EF7" Opacity="0.28"/>
    <!-- 激活态图标填色（实紫） -->
    <SolidColorBrush x:Key="CapsulePurpleBrush"       Color="#845EF7"/>

    <!-- 胶囊外阴影 -->
    <BoxShadows x:Key="ShadowCapsule">0 8 32 0 #B3000000, 0 2 8 0 #40845EF7</BoxShadows>
    <!-- 功能胶囊阴影（偏蓝调） -->
    <BoxShadows x:Key="ShadowCapsuleAction">0 6 24 0 #A0000000, 0 1 6 0 #30845EF7</BoxShadows>

    <!-- ── 尺寸 token ──────────────────────────────────────────────── -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">20</CornerRadius>

    <x:Double x:Key="FontSizeSm">11</x:Double>
    <x:Double x:Key="FontSizeMd">13</x:Double>
    <x:Double x:Key="FontSizeLg">15</x:Double>

    <BoxShadows x:Key="ShadowFloating">0 4 12 0 #80000000</BoxShadows>

    <!-- ════════════════════════════════════════════════════════════════
         SVG 图标（Material Design Icons，24x24 viewBox）
         ════════════════════════════════════════════════════════════════ -->

    <!-- 模式切换 -->
    <StreamGeometry x:Key="IconPencil">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>

